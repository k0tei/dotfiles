{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
   "logo": {
     "source": "$HOME/Imagens/Wallpaper/wallhaven-72kyke.jpg",
     "height": 9,
     "padding": {
        "top": 2,
        "right": 2
      },
   },
  "display": {
    "separator": " ✦ ",
    "color": {
      "keys": "yellow"
    },
  },
  "modules": [
    "title",
    "separator",
    {
        "type": "custom",
        "key": "┌─────────────────┐\u001b[37D",
        "format": ""
    },
    {
        "type": "os",
        "key": "├  OS",
        "keyColor": "yellow",
        "format": "{2}"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
        "type": "custom",
        "key": "└─────────────────┘",
        "format": ""
    },

    "break",

    {
        "type": "custom",
        "key": "┌─────────────────┐\u001b[37D",
        "format": ""
    },
    "display",
    "de",
    {
        "type": "wm",
        "key": "├  DE/WM",
        "keyColor": "yellow"
    },
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    {
        "type": "custom",
        "key": "└─────────────────┘",
        "format": ""
    },
    "break",
    {
        "type": "custom",
        "key": "┌─────────────────┒\u001b[37D",
        "format": ""
    },
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    {
        "type": "custom",
        "key": "└─────────────────┘",
        "format": ""
    },
    "break",

    "colors"
  ]
}
