{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
   "logo": {
     "source": "$HOME/Imagens/Wallpaper/wallhaven-72kyke.jpg",
     "height": 9,
     "padding": {
        "top": 2,
        "right": 2
      },
   },
  "display": {
    "separator": " ✦ ",
    "color": {
      "keys": "yellow"
    },
  },
  "modules": [
    "title",
    "separator",
    {
        "type": "custom",
        "format": "\u001b[33m┌─────────────────┐ \u001b[0b",
    },
    {
        "type": "os",
        "key": "├  OS",
        "keyColor": "yellow",
        "format": "{2}"
    },
    {
      "type": "host",
      "key": "├  Host",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "├  Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "├ 󱑀 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "├  Packages",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "├  Shell",
      "keyColor": "yellow"
    },
    {
        "type": "custom",
        "format": "\u001b[33m└─────────────────┘"
    },

    "break",

    {
        "type": "custom",
        "format": "\u001b[33m┌─────────────────┐\u001b[37D"
    },
    {
        "type": "display",
        "key": "├ 󰍹 Display",
        "keyColor": "yellow"
    },
    {
        "type": "wm",
        "key": "├  DE/WM",
        "keyColor": "yellow"
    },
    "wmtheme",
    "theme",
    {
        "type": "icons",
        "key": "├  Icons",
        "keyColor": "yellow"
    },
    {
        "type": "font",
        "key": "├  Font",
        "keyColor": "yellow"
    },
    {
        "type": "cursor",
        "key": "├  Cursor",
        "keyColor": "yellow"
    },
    {
        "type": "terminal",
        "key": "├  Terminal",
        "keyColor": "yellow"
    },
    {
        "type": "terminal",
        "key": "├  Terminal",
        "keyColor": "yellow"
    },
    {
        "type": "terminalfont",
        "key": "├  Terminal Font",
        "keyColor": "yellow"
    },
    {
        "type": "custom",
        "format": "\u001b[33m└─────────────────┘"
    },
    "break",
    {
        "type": "custom",
        "format": "\u001b[33m┌─────────────────┒\u001b[37D"
    },
    {
        "type": "cpu",
        "key": "├  CPU",
    },
    {
        "type": "gpu",
        "key": "├ 󰨜 GPU",
    },
    {
        "type": "swap",
        "key": "├  Swap",
    },
    {
        "type": "disk",
        "key": "├ 󱛟 Disk",
    },
    "battery",
    "poweradapter",
    {
        "type": "locale",
        "key": "├   Locale",
    },
    {
        "type": "custom",
        "format": "\u001b[33m└─────────────────┘"
    },
    "break",

    "colors"
  ]
}
