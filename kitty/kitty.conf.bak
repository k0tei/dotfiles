# font_family family="Jetbrains Mono"

background_opacity 0.90
background #0e0e0e
# CURSOR
cursor_trail 1
cursor_trail_decay 0.1 0.3
cursor_trail_color #898989
cursor_shape block
cursor_shape_unfocused hollow


# URL
detect_urls yes
url_style curly



# BEGIN_KITTY_FONTS
font_family      family='JetBrainsMono Nerd Font' features='cv01=0 cv02=0 cv03=0 cv11=0 +zero aalt=0 +ss19'
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS